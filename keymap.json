// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "space e": "pane::RevealInProjectPanel",
      "space t i": "editor::ToggleInlayHints",
      "space u w": "editor::ToggleSoftWrap",
      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",
      "space f p": "projects::OpenRecent",
      "space s b": "buffer_search::Deploy",
      "space g h d": "editor::ToggleSelectedDiffHunks",
      "g f": "editor::OpenExcerpts"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "space c a": "editor::ToggleCodeActions",
      "space .": "editor::ToggleCodeActions",
      "space c f": "editor::Format",
      "space c r": "editor::Rename",
      "space c s": "outline_panel::ToggleFocus",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDefinitionSplit",
      "g i": "editor::GoToImplementation",
      "g I": "editor::GoToImplementationSplit",
      "g t": "editor::GoToTypeDefinition",
      "g T": "editor::GoToTypeDefinitionSplit",
      "g r": "editor::FindAllReferences",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "space x x": "diagnostics::Deploy",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space g g": "git_panel::ToggleFocus",
      "space g d": "git::Diff",
      "space g e": "editor::ExpandAllDiffHunks",
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch"
    }
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space f p": "projects::OpenRecent"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "g c": "editor::ToggleComments"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j j": "vim::NormalBefore",
      "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-j": "agent::Toggle",
      "ctrl-alt-j": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-\\": "terminal_panel::ToggleFocus",
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-t": "project_symbols::Toggle"
    }
  },
  {
    "context": "AgentPanel",
    "unbind": {
      "ctrl-i": "agent::ToggleProfileSelector"
    }
  },
  {
    "context": "AcpThread > Editor",
    "unbind": {
      "ctrl-i": "agent::ToggleProfileSelector"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-i": "assistant::InlineAssist"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-shift-s": "editor::Format",
      "alt-shift-f": "editor::Format"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-j": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "EmptyPane || SharedScreen || vim_mode == normal",
    "bindings": {
      "space r t": [
        "editor::SpawnNearestTask",
        {
          "reveal": "no_focus"
        }
      ]
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-s": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-s": [
        "vim::Literal",
        [
          "ctrl-s",
          "\u0013"
        ]
      ]
    }
  },
  {
    "unbind": {
      "f11": "zed::ToggleFullScreen"
    }
  },
  {
    "bindings": {
      "f11": "debugger::StepInto"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": [
        "vim::PushSneak",
        {}
      ],
      "S": [
        "vim::PushSneakBackward",
        {}
      ]
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "space": null,
      "ctrl-w": null
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-b": "vim::PageUp"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-b": [
        "vim::Literal",
        [
          "ctrl-b",
          "\u0002"
        ]
      ]
    }
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "shift-j": "vim::JoinLines"
    }
  },
  {
    "context": "vim_mode == helix_select",
    "unbind": {
      "shift-j": "vim::JoinLines"
    }
  },
  {
    "context": "(vim_mode == normal || vim_mode == helix_normal) && !menu",
    "unbind": {
      "shift-j": "vim::JoinLines"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-shift-j": "editor::JoinLines"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-n": "workspace::NewWindow"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-n": "workspace::NewWindow"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-shift-n": "agent::NewThread"
    }
  },
  {
    "context": "AgentPanel",
    "unbind": {
      "ctrl-n": "agent::NewThread"
    }
  },
  {
    "context": "AcpThread",
    "bindings": {
      "ctrl-shift-n": "agent::NewThread"
    }
  },
  {
    "context": "AcpThread",
    "unbind": {
      "ctrl-n": "agent::NewThread"
    }
  },
  {
    "context": "AgentPanel > Terminal",
    "bindings": {
      "ctrl-shift-n": "agent::NewThread"
    }
  },
  {
    "context": "AgentPanel > Terminal",
    "unbind": {
      "ctrl-n": "agent::NewThread"
    }
  },
  {
    "context": "ThreadsSidebar",
    "bindings": {
      "ctrl-shift-n": "agents_sidebar::NewThreadInGroup"
    }
  },
  {
    "context": "ThreadsSidebar",
    "unbind": {
      "ctrl-n": "agents_sidebar::NewThreadInGroup"
    }
  }
]
