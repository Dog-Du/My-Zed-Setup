// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "minimum_split_diff_width": 0,
  "excerpt_context_lines": 32,
  "expand_excerpt_lines": 32,
  "colorize_brackets": true,
  "code_lens": "on",
  "base_keymap": "VSCode",
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 0,
  },
  "relative_line_numbers": "enabled",
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "semantic_tokens": "off",
  "minimap": {
    "show": "always",
  },
  "show_edit_predictions": true,
  "diagnostics_max_severity": "all",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "tabs": {
    "show_diagnostics": "errors",
  },
  "gutter": {
    "line_numbers": true,
  },
  "toolbar": {
    "selections_menu": true,
    "code_actions": true,
  },
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "agent_servers": {},
  "cli_default_open_behavior": "existing_window",
  "file_finder": {
    "modal_max_width": "medium",
  },
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "auto_fold_dirs": false,
    "button": true,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "sort_by_path": true,
    "tree_view": false,
    "dock": "left",
  },
  "vim": {},
  "ssh_connections": [],
  "buffer_font_family": "Menlo",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "autosave": {
    "after_delay": {
      "milliseconds": 300,
    },
  },
  "wsl_connections": [],
  "ui_font_family": ".ZedMono",
  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "font_family": "CaskaydiaCove NFM",
    "line_height": "standard",
    "show_count_badge": true,
  },
  "agent_buffer_font_size": 16.0,
  "buffer_font_weight": 500.0,
  "icon_theme": "Catppuccin Mocha",
  "use_system_path_prompts": false,
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
}
